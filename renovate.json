{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "schedule": ["before 9am on monday"],
  "labels": ["reusable-workflow"],
  "prHourlyLimit": 4,
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["spiderpunklabs/workstation"],
      "pinDigests": true,
      "groupName": "spiderpunklabs/workstation reusable workflows"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["!spiderpunklabs/workstation"],
      "enabled": false,
      "description": "Third-party action SHAs are managed centrally in spiderpunklabs/workstation; do not duplicate that PR noise here."
    }
  ]
}
